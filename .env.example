# FormSubmit — the active email path. No account or API key: the destination
# inbox is proven once by clicking a link FormSubmit emails on the first
# submission. Leave unset to use NOTIFY_EMAIL below.
FORMSUBMIT_TARGET=

# Web3Forms — optional alternative to FormSubmit. Get a key at web3forms.com;
# the destination inbox is bound to the key rather than set here.
WEB3FORMS_ACCESS_KEY=

# Notification recipient, used by FormSubmit and Resend. (Web3Forms routes by
# access key, so its destination is set on web3forms.com instead.)
# Defaults to info@goncafide.com — the site's public contact address.
NOTIFY_EMAIL=

# GoHighLevel webhook URL — paste the webhook endpoint from GHL > Triggers > Webhook
# When set, every contact/newsletter submission is POSTed as JSON to this URL.
GHL_CONTACT_WEBHOOK=

# Resend.com API key — create one at https://resend.com/api-keys
# Optional alternative to Web3Forms. The "from" domain (goncafide.com) must be
# verified in your Resend account first, which requires DNS access.
RESEND_API_KEY=
