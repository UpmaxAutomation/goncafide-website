# Web3Forms access key — get one free at https://web3forms.com
# Enter the destination inbox on their site; they email you the key.
# The destination address is bound to the key, not set here.
# This is the active email delivery path for the contact/community forms.
WEB3FORMS_ACCESS_KEY=

# Notification recipient. Only used by the Resend path below; Web3Forms
# routes by access key. Defaults to goncaf@gmail.com when unset.
NOTIFY_EMAIL=

# GoHighLevel webhook URL — paste the webhook endpoint from GHL > Triggers > Webhook
# When set, every contact/newsletter submission is POSTed as JSON to this URL.
GHL_CONTACT_WEBHOOK=

# Resend.com API key — create one at https://resend.com/api-keys
# Optional alternative to Web3Forms. The "from" domain (goncafide.com) must be
# verified in your Resend account first, which requires DNS access.
RESEND_API_KEY=
