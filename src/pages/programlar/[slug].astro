---
// Turkish programme pages. English entries live under en/ in the collection and
// are built by /en/programs/[slug]; the template itself is shared.
import { getCollection } from 'astro:content';
import { entriesFor, slugOf } from '../../i18n/ui';
import ProgramDetail from '../../components/pages/ProgramDetail.astro';

export async function getStaticPaths() {
  const programs = entriesFor(await getCollection('programlar', ({ data }) => !data.draft), 'tr');
  return programs.map((program) => ({
    params: { slug: slugOf(program.id) },
    props: { program },
  }));
}

const { program } = Astro.props;
---

<ProgramDetail program={program} />
