---
import PageLayout from '../../layouts/PageLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  'name': 'Nonviolent Communication training for organisations',
  'serviceType': 'Organisational Nonviolent Communication training',
  'description':
    'Nonviolent Communication training shaped around what teams and organisations need: communication within the team, transforming disagreement, empathy and collaboration.',
  'provider': { '@type': 'Person', '@id': 'https://www.goncafide.com/#gonca' },
  'areaServed': { '@type': 'Country', 'name': 'Turkey' },
  'availableChannel': {
    '@type': 'ServiceChannel',
    'serviceUrl': 'https://www.goncafide.com/en/contact',
  },
};

const faydalar = [
  { icon: '◯', title: 'Communication within the team', text: 'A culture of open, needs-based communication in place of judgment and blame.' },
  { icon: '◎', title: 'Transforming disagreement', text: 'The ability to resolve conflict by hearing both sides\u2019 needs rather than suppressing them.' },
  { icon: '⊕', title: 'Empathy and collaboration', text: 'Empathic listening that strengthens trust and the ground for creating together.' },
  { icon: '◈', title: 'A culture of feedback', text: 'Practice in speaking without wounding, and hearing without going on the defensive.' },
];

const surec = [
  { n: '1', title: 'A conversation about needs', text: 'Together we get clear on your team\u2019s priorities and goals.' },
  { n: '2', title: 'Designed for you', text: 'I shape the content, the length and the format — online or in person — around what is needed.' },
  { n: '3', title: 'Training through practice', text: 'Experiential learning through real situations, lived and shared rather than lectured.' },
];
---

<PageLayout
  title="For organisations"
  description="Nonviolent Communication training designed for organisations and teams. Shaped around communication within the team, transforming disagreement and empathy."
>
  <JsonLd slot="jsonld" schema={schema} />

  <!-- Hero -->
  <section class="bg-[var(--color-surface)] pt-12 pb-16 lg:pt-20 lg:pb-24 border-b border-[var(--color-border)]">
    <div class="container-site">
      <p class="eyebrow mb-4">For organisations</p>
      <h1 class="font-display text-4xl lg:text-5xl xl:text-6xl font-light -tracking-[0.04em] text-[var(--color-ink)] leading-[1.05] mb-6 max-w-3xl">
        Nonviolent Communication,<br class="hidden lg:block" /> designed for your organisation
      </h1>
      <p class="text-[var(--color-ink-muted)] text-lg max-w-2xl mb-8">
        I run trainings shaped around what teams and organisations need. The aim is to turn the cycle of
        blame and defence into a culture of communication that hears needs and builds connection.
      </p>
      <a
        href="/en/contact?program=kurumsal"
        class="inline-flex items-center justify-center py-4 px-8 rounded-xl bg-[var(--color-orchid-500)] text-white font-semibold text-sm hover:bg-[var(--color-orchid-600)] transition-colors min-h-[52px]"
      >
        Request a training
      </a>
    </div>
  </section>

  <!-- Faydalar -->
  <section class="section-padding bg-[var(--color-canvas)]">
    <div class="container-site">
      <div class="mb-10">
        <p class="eyebrow mb-3">What does it bring?</p>
        <h2 class="font-display text-2xl lg:text-3xl font-light -tracking-[0.03em] text-[var(--color-ink)]">
          What it strengthens in your team
        </h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 lg:gap-6">
        {faydalar.map((f) => (
          <div class="flex items-start gap-4 p-6 lg:p-7 rounded-2xl bg-white" style="box-shadow: var(--shadow-card);">
            <div class="w-10 h-10 rounded-xl flex items-center justify-center flex-shrink-0 text-[var(--color-plum-600)] text-xl bg-[var(--color-plum-50)]" aria-hidden="true">{f.icon}</div>
            <div>
              <h3 class="font-display text-xl font-light -tracking-[0.02em] text-[var(--color-ink)] mb-1.5 leading-snug">{f.title}</h3>
              <p class="text-[var(--color-ink-muted)] text-sm leading-relaxed">{f.text}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Süreç -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="container-site">
      <div class="mb-10">
        <p class="eyebrow mb-3">How we work</p>
        <h2 class="font-display text-2xl lg:text-3xl font-light -tracking-[0.03em] text-[var(--color-ink)]">
          Designed in three steps
        </h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 lg:gap-6">
        {surec.map((s) => (
          <div class="p-6 lg:p-7 rounded-2xl bg-white" style="box-shadow: var(--shadow-card);">
            <span class="font-display text-3xl font-light text-[var(--color-orchid-500)]">{s.n}</span>
            <h3 class="font-display text-xl font-light text-[var(--color-ink)] mt-3 mb-2 -tracking-[0.02em]">{s.title}</h3>
            <p class="text-[var(--color-ink-muted)] text-sm leading-relaxed">{s.text}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-plum-800)] py-16">
    <div class="container-site text-center">
      <h2 class="font-display text-3xl lg:text-4xl font-light text-white mb-4 -tracking-[0.03em]">
        Let us talk about a training for your organisation
      </h2>
      <p class="text-[var(--color-cream)]/70 mb-8 max-w-md mx-auto text-base">
        Tell me what you need, and we will design the right content together.
      </p>
      <a
        href="/en/contact?program=kurumsal"
        class="inline-flex items-center justify-center py-4 px-8 rounded-xl bg-[var(--color-orchid-500)] text-white font-semibold text-sm hover:bg-[var(--color-orchid-400)] transition-colors min-h-[52px]"
      >
        Get in touch
      </a>
    </div>
  </section>
</PageLayout>
