---
import PageLayout from '../../layouts/PageLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';
import YouTubeEmbed from '../../components/ui/YouTubeEmbed.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "ProfilePage",
  "name": "About Gonca Fide",
  "url": "https://www.goncafide.com/en/about",
  "about": {
    "@type": "Person",
    "@id": "https://www.goncafide.com/#gonca",
    "name": "Gonca Fide"
  }
};

// Newest → oldest, per Gonca's 2026-07-13 feedback ("sırayı tersine çevirelim").
const credentials = [
  { year: '—', label: 'Over 1500 hours of Nonviolent Communication training', detail: 'Training received and training given' },
  { year: 'Since 2022', label: 'CNVC Certified Trainer', detail: 'Center for Nonviolent Communication' },
  { year: '2017–2022', label: 'Teaching Nonviolent Communication', detail: 'Years of training and sharing' },
  { year: '2017–2022', label: 'Social impact specialist', detail: 'Social impact in the energy sector' },
  { year: '2013–2016', label: 'BBOM Ankara Cooperative', detail: 'General Coordinator and Chair of the Board' },
  { year: '2008–2012', label: 'Nature conservation project management', detail: 'Wildlife and erosion prevention projects' },
  { year: '2000–2007', label: 'Rural development project management', detail: 'National and international programmes' },
  { year: '1999', label: 'METU, Sociology', detail: 'Graduate of Middle East Technical University' },
];

const background = [
  { area: 'International development', icon: 'globe' },
  { area: 'Nature conservation', icon: 'leaf' },
  { area: 'Social impact in energy', icon: 'spark' },
  { area: 'Alternative education', icon: 'book' },
];

const bgIcons: Record<string, string> = {
  globe: '<circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"/><path d="M3 12h18M12 3c2.5 2.5 2.5 15 0 18M12 3c-2.5 2.5-2.5 15 0 18" stroke="currentColor" stroke-width="1.5"/>',
  leaf: '<path d="M5 19c0-7 5-12 14-12 0 9-5 14-12 14-1.5 0-2-1-2-2zM5 19c2-4 5-6 9-7" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  spark: '<path d="M13 2L5 13h6l-2 9 8-11h-6l2-9z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
  book: '<path d="M4 5.5A2 2 0 0 1 6 4h6v15H6a2 2 0 0 0-2 1.5V5.5zM20 5.5A2 2 0 0 0 18 4h-6v15h6a2 2 0 0 1 2 1.5V5.5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>',
};
---

<PageLayout
  title="About"
  description="Gonca Fide — sociology graduate of METU and CNVC Certified Nonviolent Communication Trainer, with more than 1500 hours of NVC training experience."
>
  <JsonLd slot="jsonld" schema={schema} />

  <!-- Hero -->
  <section class="bg-[var(--color-surface)] pt-12 pb-16 lg:pt-20 lg:pb-24 border-b border-[var(--color-border)]">
    <div class="container-site">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
        <!-- Text -->
        <div>
          <p class="eyebrow mb-4">About</p>
          <h1 class="font-display text-4xl lg:text-5xl font-medium -tracking-[0.02em] text-[var(--color-ink)] leading-[1.08] mb-6">
            Who is Gonca Fide?
          </h1>
          <p class="text-[var(--color-ink-muted)] text-lg leading-relaxed mb-6">
            I am a sociology graduate of METU. I worked on development, nature conservation, wildlife and erosion prevention projects within national and international programmes, and in the social impact field of the energy sector. Visiting countless Anatolian villages, I saw that people had far more in common than not — and that they fell into disagreement because they had never had the experience of letting their perspective flex.
          </p>
          <p class="text-[var(--color-ink-muted)] text-lg leading-relaxed mb-6">
            Between 2016 and 2022 I trained with the CNVC Certified Trainers Vivet Alevi, Stephan Seibert, Deniz Spatar and Liv Larsson. Since 2023 I have been assisting on the International Mediation Training Programme run by Liv Larsson and Kay Rung.
          </p>
          <p class="text-[var(--color-ink-muted)] text-lg leading-relaxed mb-6">
            Since 2019 I have been a member of the Nonviolent Communication Association of Turkey, which works to grow NVC in the country.
          </p>
          <p class="text-[var(--color-ink-muted)] text-lg leading-relaxed mb-8">
            In 2022 I became a CNVC Certified Trainer, and I continue to offer my workshops both online and in person.
          </p>
          <div class="flex flex-wrap gap-3">
            <a
              href="/en/programs"
              class="inline-flex items-center justify-center py-3.5 px-6 rounded-xl bg-[var(--color-orchid-500)] text-white font-semibold text-sm tracking-wide hover:bg-[var(--color-orchid-600)] transition-colors min-h-[48px]"
            >
              Explore the programmes
            </a>
            <a
              href="/en/contact"
              class="inline-flex items-center justify-center py-3.5 px-6 rounded-xl border border-[var(--color-ink)]/20 text-[var(--color-ink)] font-medium text-sm hover:bg-[var(--color-surface)] transition-colors min-h-[48px]"
            >
              Get in touch
            </a>
          </div>
        </div>

        <!-- Portrait -->
        <div class="flex justify-center lg:justify-end">
          <div class="relative">
            <div
              class="absolute -inset-4 rounded-[2.5rem] bg-gradient-to-br from-[var(--color-plum-100)] to-[var(--color-plum-50)] -z-10"
              aria-hidden="true"
            ></div>
            <div
              class="w-64 h-80 sm:w-80 sm:h-96 rounded-[2rem] overflow-hidden"
              style="box-shadow: var(--shadow-elevated);"
            >
              <img
                src="/images/gonca-fide.jpg"
                alt="Gonca Fide — CNVC Certified Nonviolent Communication Trainer"
                width="416"
                height="603"
                loading="eager"
                fetchpriority="high"
                class="w-full h-full object-cover object-top"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Credentials timeline -->
  <section class="section-padding bg-[var(--color-canvas)]">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow mb-4">Experience &amp; training</p>
        <h2 class="font-display text-3xl lg:text-4xl font-light -tracking-[0.03em] text-[var(--color-ink)] mb-10">
          Credentials
        </h2>

        <div class="relative">
          <div class="absolute left-4 top-0 bottom-0 w-px bg-[var(--color-plum-200)]" aria-hidden="true"></div>
          <div class="space-y-8 pl-12">
            {credentials.map((cred) => (
              <div class="relative">
                <div
                  class="absolute -left-8 top-1 w-4 h-4 rounded-full bg-[var(--color-plum-400)] border-2 border-[var(--color-canvas)]"
                  aria-hidden="true"
                ></div>
                <div>
                  <p class="text-xs font-medium text-[var(--color-plum-500)] mb-1 font-body uppercase tracking-wider">
                    {cred.year}
                  </p>
                  <h3 class="font-display text-xl font-light text-[var(--color-ink)] mb-1">
                    {cred.label}
                  </h3>
                  <p class="text-sm text-[var(--color-ink-muted)]">{cred.detail}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Background areas -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="container-site">
      <p class="eyebrow mb-4">Background</p>
      <h2 class="font-display text-3xl lg:text-4xl font-light -tracking-[0.03em] text-[var(--color-ink)] mb-10">
        Before NVC: experience across several fields
      </h2>
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
        {background.map((item, i) => (
          <div
            class="card-rise p-5 lg:p-6 rounded-2xl bg-white text-center flex flex-col items-center"
            style="box-shadow: var(--shadow-card);"
            data-reveal data-reveal-delay={String((i % 4) + 1)}
          >
            <span class="w-11 h-11 mb-3 rounded-xl flex items-center justify-center bg-[var(--color-plum-50)] text-[var(--color-plum-600)]" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" set:html={bgIcons[item.icon]} />
            </span>
            <p class="font-body text-sm font-medium text-[var(--color-ink)]">{item.area}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Story / mission -->
  <section class="section-padding bg-[var(--color-canvas)]">
    <div class="container-site">
      <div class="max-w-2xl">
        <p class="eyebrow mb-4">My journey</p>
        <h2 class="font-display text-3xl lg:text-4xl font-light -tracking-[0.03em] text-[var(--color-ink)] mb-6">
          How does common ground come about?
        </h2>
        <div class="space-y-5 text-[var(--color-ink-muted)] leading-relaxed max-w-[60ch]">
          <p>
            How the possibility of common ground gets created has always been a personal curiosity of mine.
            Looking for a school for my daughter, I came across the “Another School is Possible” (BBOM)
            movement; alongside my professional life I volunteered through the founding years of the BBOM
            Ankara Cooperative as General Coordinator and Chair of the Board, and played an active part on
            the board of the BBOM Association.
          </p>
          <p>
            While learning about alternative and democratic approaches to education, I met Nonviolent
            Communication. Through Marshall Rosenberg's “needs-based approach” I experienced how our
            communication habits can change. What I share is the craft of communicating from our empathic
            nature — without distinction of gender, age, religion, race or nationality.
          </p>
          <p>
            I see how powerful this language — needs-based, threaded through with empathy — is at creating
            nonviolence, and I keep doing what I can to help it spread. My trainings are about opening spaces
            where learning happens by living it and sharing it.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Video & Podcast -->
  <section class="section-padding bg-[var(--color-surface-iris)]">
    <div class="container-site">
      <div class="max-w-2xl mb-10">
        <p class="eyebrow mb-4">Video &amp; podcast</p>
        <h2 class="font-display text-3xl lg:text-4xl font-light -tracking-[0.03em] text-[var(--color-ink)] mb-4">
          Listen, and let us meet
        </h2>
        <p class="text-[var(--color-ink-muted)] leading-relaxed">
          Conversations and podcast episodes on Nonviolent Communication. Before we work together, you can
          hear my voice and my approach here.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
        <div data-reveal>
          <YouTubeEmbed id="N93XALPo0_k" start={73} title="Meet Gonca Fide" />
          <p class="mt-3 font-display text-lg font-light text-[var(--color-ink)]">Introduction</p>
          <p class="text-sm text-[var(--color-ink-muted)]">On Gonca Fide and her Nonviolent Communication journey.</p>
        </div>
        <div data-reveal data-reveal-delay="1">
          <YouTubeEmbed id="LWQituchtPg" start={600} title="Podcast — a conversation on Nonviolent Communication" />
          <p class="mt-3 font-display text-lg font-light text-[var(--color-ink)]">Podcast</p>
          <p class="text-sm text-[var(--color-ink-muted)]">A podcast conversation about Nonviolent Communication.</p>
        </div>
        <div data-reveal data-reveal-delay="2">
          <YouTubeEmbed id="5L0OsNC_Too" title="Key Differentiations 2026 — introduction" />
          <p class="mt-3 font-display text-lg font-light text-[var(--color-ink)]">Key Differentiations 2026</p>
          <p class="text-sm text-[var(--color-ink-muted)]">An introduction to the new round of the Key Differentiations Programme.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact strip -->
  <section class="py-14 bg-[var(--color-plum-800)]">
    <div class="container-site text-center">
      <h2 class="font-display text-3xl lg:text-4xl font-light text-white mb-6 -tracking-[0.03em]">
        Ready to explore what I offer?
      </h2>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/en/programs"
          class="inline-flex items-center justify-center py-4 px-8 rounded-xl bg-[var(--color-orchid-500)] text-white font-semibold text-sm hover:bg-[var(--color-orchid-400)] transition-colors min-h-[52px]"
        >
          See the offerings
        </a>
        <a
          href="https://instagram.com/goncolog"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 py-4 px-8 rounded-xl border border-white/30 text-white font-medium text-sm hover:bg-white/10 transition-colors min-h-[52px]"
        >
          @goncolog
        </a>
      </div>
    </div>
  </section>
</PageLayout>
