---
import PageLayout from '../../layouts/PageLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';

const steps = [
  {
    number: '01',
    title: 'Observation',
    subtitle: 'What happened?',
    description: 'Observation describes concretely what happened in the moment, in place of evaluation, interpretation or judgment.',
    example: 'Evaluation: "You are lazy, you leave everything to the last minute." → Observation: "I noticed you studied the night before each of your last three exams."',
    color: 'var(--color-plum-500)',
  },
  {
    number: '02',
    title: 'Feeling',
    subtitle: 'What am I feeling?',
    description: 'We say what we feel in connection with that observation. Not thoughts or interpretations — only feelings: sad, afraid, happy, tired…',
    example: '"…I feel worried."',
    color: 'var(--color-plum-600)',
  },
  {
    number: '03',
    title: 'Need',
    subtitle: 'Which need is alive in me?',
    description: 'Our feelings are messengers of needs, met or unmet. Needs are universal: connection, respect, autonomy, safety, contribution…',
    example: '"…I need to know you are giving yourself enough time to learn what you need to pass."',
    color: 'var(--color-plum-700)',
  },
  {
    number: '04',
    title: 'Request',
    subtitle: 'What am I asking for?',
    description: 'We ask for a concrete, positive, present-moment action that would enrich our lives. A request is not a demand; it rests on mutual willingness.',
    example: '"…Could we talk about this now?"',
    color: 'var(--color-plum-800)',
  },
];

const faqs = [
  {
    q: 'What is Nonviolent Communication (NVC)?',
    a: 'Nonviolent Communication (NVC) is a communication model and a discipline of awareness developed by the clinical psychologist Prof. Dr. Marshall Rosenberg. The model has four steps — observation, feeling, need, request — and lets people connect on a ground of empathy and honesty.'
  },
  {
    q: 'Where can NVC training be found in Turkey?',
    a: 'In Turkey, training is available from CNVC Certified Trainers and trainer candidates affiliated with the Nonviolent Communication Association of Turkey. For more, visit www.siddetsiziletisim.com.'
  },
  {
    q: 'How long does it take to learn NVC, and how?',
    a: 'The foundations of NVC can usually be learned in a 12-hour workshop. To build the skills, joining a year-long programme is recommended. If you want to go deeper and let your level of awareness show in how you communicate, the intermediate and advanced trainings Gonca Fide offers are worth taking.'
  },
  {
    q: 'Who is NVC for?',
    a: 'Any adult who wants to strengthen their relationships — at home, at work, at school, in their private life — can join an NVC training.'
  },
  {
    q: 'Is NVC only about spoken language?',
    a: 'No. It covers spoken, written and non-verbal communication alike.'
  },
  {
    q: 'What is CNVC?',
    a: 'CNVC (Center for Nonviolent Communication) is a non-profit international peace organisation formed by those who share Nonviolent Communication around the world. It helps people resolve conflict peacefully and effectively in personal, organisational and political settings. More at siddetsiziletisim.com.'
  },
  {
    q: 'What is a CNVC Certified Trainer?',
    a: 'It is the title held by those who have met the requirements set out in the Certification Preparation Packet (CPP) of CNVC\u2019s Trainer Services, and who have been recommended to CNVC as a trainer by an Assessor.'
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "FAQPage",
      "url": "https://www.goncafide.com/en/what-is-nvc",
      "name": "What is Nonviolent Communication (NVC)? — Frequently Asked Questions",
      "mainEntity": faqs.map((f) => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a },
      })),
    },
    {
      "@type": "Article",
      "headline": "What is Nonviolent Communication?",
      "url": "https://www.goncafide.com/en/what-is-nvc",
      "author": {
        "@type": "Person",
        "@id": "https://www.goncafide.com/#gonca"
      },
      "inLanguage": "en"
    }
  ]
};
---

<PageLayout
  title="What is Nonviolent Communication?"
  description="Nonviolent Communication (NVC) is an empathy-based communication model developed by Marshall Rosenberg. A full guide to its four steps, where it is used, and NVC training in Turkey."
>
  <JsonLd slot="jsonld" schema={faqSchema} />

  <!-- Hero -->
  <section class="bg-[var(--color-surface)] pt-12 pb-14 lg:pt-20 lg:pb-20 border-b border-[var(--color-border)]">
    <div class="container-site max-w-3xl">
      <p class="eyebrow mb-4">Nonviolent Communication</p>
      <h1 class="font-display text-4xl lg:text-5xl xl:text-6xl font-light -tracking-[0.04em] text-[var(--color-ink)] leading-[1.05] mb-6">
        What is Nonviolent Communication?
      </h1>
      <p class="text-[var(--color-ink-muted)] text-lg lg:text-xl leading-relaxed">
        Nonviolent Communication (NVC) is a philosophy of communication and of living, developed by the
        clinical psychologist Prof. Dr. <strong>Marshall Rosenberg</strong>. It puts empathy, honesty and an
        awareness of needs at the centre, strengthening the connection between people while transforming
        conflict.
      </p>
    </div>
  </section>

  <!-- 4 Steps -->
  <section class="section-padding bg-[var(--color-canvas)]">
    <div class="container-site">
      <div class="max-w-2xl mb-12">
        <h2 class="font-display text-3xl lg:text-4xl font-light -tracking-[0.03em] text-[var(--color-ink)] mb-4">
          Four steps: observation, feeling, need, request
        </h2>
        <p class="text-[var(--color-ink-muted)] text-base lg:text-lg leading-relaxed">
          The NVC model separates communication into four steps. Each offers a frame both for understanding
          our own inner world and for meeting others with empathy.
        </p>
      </div>

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
        {steps.map((step) => (
          <div
            class="p-7 rounded-2xl bg-white"
            style="box-shadow: var(--shadow-card);"
          >
            <div class="flex items-center gap-3 mb-5">
              <div
                class="w-10 h-10 rounded-full flex items-center justify-center text-white font-display font-light text-sm flex-shrink-0"
                style={`background-color: ${step.color};`}
              >
                {step.number}
              </div>
              <div>
                <h3 class="font-display text-xl font-light text-[var(--color-ink)] -tracking-[0.02em]">
                  {step.title}
                </h3>
                <p class="text-xs text-[var(--color-ink-muted)] font-body">{step.subtitle}</p>
              </div>
            </div>
            <p class="text-[var(--color-ink-muted)] text-sm leading-relaxed mb-4">
              {step.description}
            </p>
            <div class="bg-[var(--color-plum-50)] rounded-xl p-3.5 border-l-2 border-[var(--color-plum-400)]">
              <p class="text-sm font-display italic text-[var(--color-plum-800)]">
                Example: {step.example}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Use cases -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="container-site max-w-3xl">
      <h2 class="font-display text-3xl lg:text-4xl font-light -tracking-[0.03em] text-[var(--color-ink)] mb-6">
        What is Nonviolent Communication good for?
      </h2>
      <div class="prose prose-lg">
        <p>
          On the surface NVC can look like a "communication technique", but at heart it is a far deeper
          philosophy of living. It draws on the understanding of nonviolence held by Martin Luther King Jr.
          and Mahatma Gandhi. NVC is an awareness discipline practised actively in more than 50 countries.
        </p>
        <h3>NVC brings change in these areas:</h3>
        <ul>
          <li><strong>Personal relationships:</strong> deeper connection between partners, family members and friends</li>
          <li><strong>Parenting:</strong> communicating with children from empathy rather than authority</li>
          <li><strong>Working life:</strong> transforming conflict in teams, leadership, negotiation</li>
          <li><strong>Education:</strong> strengthening the relationship between student and teacher</li>
          <li><strong>Mediation:</strong> NVC-based negotiation and reconciliation</li>
          <li><strong>The inner voice:</strong> a kinder, more honest relationship with yourself</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- Who is it for -->
  <section class="section-padding bg-[var(--color-canvas)]">
    <div class="container-site max-w-3xl">
      <h2 class="font-display text-3xl lg:text-4xl font-light -tracking-[0.03em] text-[var(--color-ink)] mb-6">
        Who can learn Nonviolent Communication?
      </h2>
      <p class="text-[var(--color-ink-muted)] text-base lg:text-lg leading-relaxed mb-8">
        NVC is for everyone. No prior knowledge or experience is needed.
      </p>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-4">
        {['Parents', 'Educators', 'Managers & leaders', 'Therapists & coaches', 'Mediators', 'Everyone'].map((who) => (
          <div
            class="flex items-center justify-center text-center p-4 rounded-xl bg-[var(--color-surface)] text-sm font-body text-[var(--color-ink)] min-h-[60px]"
            style="box-shadow: var(--shadow-card);"
          >
            {who}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section-padding bg-[var(--color-surface)]">
    <div class="container-site max-w-3xl">
      <h2 class="font-display text-3xl lg:text-4xl font-light -tracking-[0.03em] text-[var(--color-ink)] mb-10">
        Frequently Asked Questions
      </h2>

      <dl class="space-y-0 divide-y divide-[var(--color-border)]">
        {faqs.map((faq) => (
          <div class="py-6 first:pt-0">
            <dt class="font-display text-xl font-light text-[var(--color-ink)] mb-3 -tracking-[0.01em]">
              {faq.q}
            </dt>
            <dd class="text-[var(--color-ink-muted)] text-base leading-relaxed">
              {faq.a}
            </dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Kaynaklar -->
  <section class="section-padding bg-[var(--color-surface-iris)]">
    <div class="container-site max-w-3xl">
      <p class="eyebrow mb-4">Going further</p>
      <h2 class="font-display text-2xl lg:text-3xl font-light -tracking-[0.03em] text-[var(--color-ink)] mb-6">
        Resources
      </h2>
      <ul class="space-y-3">
        <li>
          <a href="https://www.cnvc.org" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[var(--color-iris-700)] hover:text-[var(--color-iris-800)] font-medium link-underline">
            cnvc.org — Center for Nonviolent Communication
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
        <li>
          <a href="https://www.siddetsiziletisim.com" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 text-[var(--color-iris-700)] hover:text-[var(--color-iris-800)] font-medium link-underline">
            siddetsiziletisim.com — Nonviolent Communication Turkey
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M6 3h7v7M13 3 4 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </a>
        </li>
      </ul>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-plum-800)] py-16">
    <div class="container-site text-center">
      <h2 class="font-display text-3xl lg:text-4xl font-light text-white mb-4 -tracking-[0.03em]">
        Join the introductory programme
      </h2>
      <p class="text-[var(--color-cream)]/70 mb-8 max-w-md mx-auto">
        Learn NVC in practice, not in theory. The Attunement into Now introductory programme is built for that.
      </p>
      <a
        href="/en/programs/anda-kal-canda-kal"
        class="inline-flex items-center justify-center py-4 px-8 rounded-xl bg-[var(--color-orchid-500)] text-white font-semibold text-sm hover:bg-[var(--color-orchid-400)] transition-colors min-h-[52px]"
      >
        Join the programme
      </a>
    </div>
  </section>
</PageLayout>
