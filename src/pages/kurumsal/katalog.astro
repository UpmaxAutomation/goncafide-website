---
import PageLayout from '../../layouts/PageLayout.astro';
import JsonLd from '../../components/seo/JsonLd.astro';

const PDF = '/gonca-fide-kurumsal-katalog.pdf';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'Kurumlar için Şiddetsiz İletişim — Eğitim Kataloğu',
  description:
    'Gonca Fide’nin kurumlara yönelik Şiddetsiz İletişim eğitim kataloğu: ekip içi iletişim, geri bildirim kültürü, anlaşmazlık dönüştürme ve liderlikte güç ayrımları modülleri.',
  provider: { '@type': 'Person', '@id': 'https://www.goncafide.com/#gonca' },
  inLanguage: 'tr',
  url: 'https://www.goncafide.com/kurumsal/katalog',
};

/**
 * Modules are drawn from the four series of Gonca's 66-session Anahtar Ayrımlar
 * curriculum (AA · EA · ZC · GUC), scaled for corporate delivery. Durations are
 * suggestions — the corporate page promises a design shaped around each need.
 */
const series = [
  {
    code: 'AA',
    name: 'Temel Ayrımlar',
    note: 'İletişimin yapı taşları',
    modules: [
      {
        title: 'Ekipte Ortak Dil',
        line: '“Sen hep…” ile başlayan cümle, karşısındakinde savunma refleksi uyandırır.',
        body: 'Şiddetsiz İletişim’in dört adımı — gözlem, duygu, ihtiyaç, rica — ve bunların gündelik iş konuşmalarına taşınması. Değerlendirmeyle gözlemi, talebi ricadan, ihtiyacı stratejiden ayırt etmek. Ekibin ortak bir dile kavuştuğu, diğer bütün modüllerin üzerine kurulduğu zemin.',
        meta: ['1 tam gün ya da 2 yarım gün', 'Online / yüz yüze', 'Tüm ekip'],
      },
      {
        title: 'Tetikleyen Olay, Gerçek Sebep',
        line: 'Bizi öfkelendiren şey, çoğu zaman bizi öfkelendiren şey değildir.',
        body: 'Uyaran ile neden arasındaki ayrım. Bir davranışın bizde uyandırdığı tepkinin kaynağı çoğunlukla o davranış değil, karşılanmamış bir ihtiyaçtır. Kriz anında suçlu aramak yerine sebebi görebilmek — ve tartışmayı kişiselleştirmeden sürdürebilmek.',
        meta: ['Yarım gün', 'Yöneticiler · ekipler'],
      },
    ],
  },
  {
    code: 'EA',
    name: 'Empati',
    note: 'Dinlemenin incelikleri',
    modules: [
      {
        title: 'Çözüm Sunmadan Önce Duymak',
        line: '“Anlıyorum” demek, anlaşıldığını hissettirmez.',
        body: 'Empatiyi öneriden, tesellidan ve bilgi vermekten ayırmak. Aktif dinleme sırasında yaptığımız her hamlenin karşı tarafta neye yol açtığını teoride ve canlı pratikte görmek. Yöneticinin “hemen çözelim” refleksinin, çözülmesi gereken şeyi nasıl gizlediğini fark etmek.',
        meta: ['1 tam gün', 'Yöneticiler · İK · müşteriyle temas eden ekipler'],
      },
      {
        title: 'Tükenmeden Çalışmak',
        line: 'Öz bakım ile bencillik aynı şey değil; ekipler bu ayrımı bilmediğinde tükeniyor.',
        body: 'Kendine empati pratiği. Öz bakımla bencilliği, öz şefkatle sorumluluktan kaçışı ayırmak. Duyguya takılıp kalmakla ihtiyaca bağlanmak arasındaki fark. Yoğun tempoda çalışan ekipler için koruyucu bir oturum.',
        meta: ['Yarım gün', 'Tüm ekip · İK'],
      },
    ],
  },
  {
    code: 'ZC',
    name: 'Zürafa – Çakal Dili',
    note: 'Dürüstlük, sınır ve onarım',
    modules: [
      {
        title: 'Zedelemeden Söylemek, Savunmaya Geçmeden Duymak',
        line: 'Geri bildirimin raf ömrü vardır; bekletilen geri bildirim şikâyete dönüşür.',
        body: 'Geri bildirim kültürünün çekirdeği. Onayla takdiri, geri bildirimle kendini ifadeyi, dürüstlükle zorbalığı ayırmak. Performans görüşmelerini ve gündelik geri bildirimi taraflaşmadan yürütmek — söyleyenin de duyanın da kaçmak zorunda kalmadığı bir zemin kurmak.',
        meta: ['1 tam gün', 'Yöneticiler · İK · ekip liderleri'],
      },
      {
        title: 'Hayır Demek, Hayır Duymak',
        line: 'Gönülsüz “evet”, pahalı bir “hayır”dan daha pahalıdır.',
        body: 'Söylenemeyen “hayır”ın kuruma faturası: gecikme, unutma, sessiz direniş, son anda çöken teslimatlar. Kişiye değil stratejiye “hayır” diyebilmek; ihtiyaçta sebat ederken bağlantıyı koruyabilmek. Kapasite ve öncelik konuşmalarına doğrudan uygulanır.',
        meta: ['Yarım gün', 'Tüm ekip · proje yöneticileri'],
      },
      {
        title: 'Onarım Konuşmaları',
        line: 'Özür, olan biteni kapatmak için değil, güveni yeniden kurmak için vardır.',
        body: 'Kırılan güvenin ardından ne konuşulur? Çakal özrüyle zürafa özrü arasındaki fark, affetmekle tolere etmek, güvenin dört bileşeni. Zayıflıkla kırılganlığı ayırmak — ve kırılganlığın iş yerinde nerede işe yaradığını, nerede yaramadığını görmek.',
        meta: ['Yarım gün', 'Ekipler · yöneticiler'],
      },
    ],
  },
  {
    code: 'GÜÇ',
    name: 'Güç Ayrımları',
    note: 'Liderlik, otorite ve sistemler',
    modules: [
      {
        title: 'Üzerine Güç Yerine Birlikte Güç',
        line: 'İtaat eden ekip, sorun çıktığında haber vermeyen ekiptir.',
        body: 'Yapısal gücü ilişkisel güçten ayırmak. Tahakküm odaklı sistemlerle ihtiyaç odaklı sistemlerin farkı; itaat–isyan sarmalıyla gönülden teslim edilen otorite arasındaki mesafe. Yöneticinin elindeki gücü nasıl kullandığının ekipte neyi mümkün kıldığı, neyi imkânsızlaştırdığı.',
        meta: ['1 tam gün', 'Yöneticiler · liderlik ekipleri'],
      },
      {
        title: 'Ceza Değil Sonuç',
        line: 'Otoriteye saygı ile otoriteden korku, dışarıdan aynı görünür; sonuçları aynı değildir.',
        body: 'Cezalandırıcı yaklaşımla doğal sonuç arasındaki ayrım; koruyucu kuvvetle cezalandırıcı kuvvet. Disiplin ve performans süreçlerini yeniden düşünmek isteyen kurumlar için — kuralların neden delindiğini anlamak isteyenler için.',
        meta: ['Yarım gün', 'Yöneticiler · İK'],
      },
      {
        title: 'İçsel Motivasyon',
        line: 'Teşvik sistemleri bazen tam da öldürmek istemediğiniz şeyi öldürür.',
        body: 'İçsel ve dışsal motivasyonun ayrımı, öz disiplinle itaat arasındaki fark, başarmakla yaratmak. Daniel Pink’in <em>Drive</em> çerçevesiyle beslenen, ödül ve teşvik tasarımını sorgulayan bir oturum.',
        meta: ['Yarım gün', 'Yöneticiler · İK · ödül-teşvik tasarlayanlar'],
      },
      {
        title: 'Anlaşmazlığı Dönüştürmek',
        line: 'Çatışma bir tehdit değil, karşılanmamış ihtiyaçlar hakkında bilgidir.',
        body: 'Anlaşmazlığın anatomisi, tetiklenme anında kendiyle çalışma, iki taraf arasında köprü kurma ve ihtiyaçlardan çözüme geçiş. Anlaşmakla anlayış göstermeyi, ödün vermekle içsel değişimi ayırmak. Kurum içi arabuluculuk rolü üstlenenler için temel.',
        meta: ['2 tam gün ya da modüler seri', 'Yüz yüze önerilir', 'Yöneticiler · İK · arabulucular'],
      },
    ],
  },
  {
    code: 'TEMA',
    name: 'Tek Oturumluk Atölyeler',
    note: 'Kısa, odaklı, tek bir konu',
    modules: [
      {
        title: 'Şaka Gibi… Neye Neden Gülüyoruz?',
        line: 'Aynı şaka birini rahatlatırken bir başkasını yaralayabilir.',
        body: 'Mizahın nerede bağ kurduğunu, nerede mesafe ve dışlanma yarattığını gözlem–duygu–ihtiyaç bakışıyla incelemek. Kapsayıcılık çalışmalarına doğrudan bağlanan, ekibin kendi mizahına şefkatle bakabildiği bir oturum.',
        meta: ['2–3 saat', 'Tüm ekip'],
      },
      {
        title: 'Kıyas: Haset ve Kıskançlık',
        line: 'Terfi listesi açıklandığında konuşulmayan şey.',
        body: 'Takdir, görünürlük ve terfi etrafında dönen kıyaslama duygularını yargılamadan ele almak. Bu duyguların işaret ettiği ihtiyaçları duyabilmek ve ekipte konuşulmayanı konuşulabilir kılmak.',
        meta: ['2–3 saat', 'Tüm ekip · İK'],
      },
      {
        title: 'Küsmek',
        line: 'Cevapsız kalan e-posta da bir cümledir.',
        body: 'Sessizliğin dili: pasif direniş, toplantıda söylenmeyenler, geri çekilme. Küsmenin altındaki duyulmamış kırgınlığı görüp bağlantıyı koruyan ifade biçimlerini denemek.',
        meta: ['2–3 saat', 'Ekipler'],
      },
    ],
  },
];

const gains = [
  { t: 'Ekip içi iletişim', d: 'Yargı ve suçlama yerine ihtiyaç odaklı, açık bir dil. Toplantılarda söylenmeyenlerin azalması.' },
  { t: 'Anlaşmazlık dönüştürme', d: 'Çatışmaları bastırmadan, her iki tarafın ihtiyacını duyarak çözebilme becerisi.' },
  { t: 'Geri bildirim kültürü', d: 'Zedelemeden söyleyebilme ve savunmaya geçmeden duyabilme pratiği.' },
  { t: 'Empati ve iş birliği', d: 'Empatik dinlemeyle güvenin ve birlikte üretme zemininin güçlenmesi.' },
];

/** Kurumların satın aldığı üç ayrı çalışma biçimi. */
const services = [
  {
    id: 'kocluk',
    n: 'Bire bir',
    t: 'Empatik Koçluk',
    d: 'Yöneticiler ve anahtar roller için bireysel seanslar. Zor bir kararın eşiğinde, bir çatışmanın içinde ya da yalnızca düşünmek için ayrılmış bir alan.',
  },
  {
    id: 'danismanlik',
    n: 'Danışmanlık',
    t: 'Anlaşmazlık Dönüştürme',
    d: 'Şirket içinde ya da dışında tıkanmış bir anlaşmazlığa eşlik etmek. Eğitim değil, gerçek bir meselenin üzerinde çalışmak.',
  },
  {
    id: 'egitimler',
    n: 'Eğitim',
    t: 'Tematik, kısa, orta ve uzun dönemli',
    d: 'Tek oturumluk atölyelerden aylara yayılan kapalı grup programlarına kadar, ekibin ayırabildiği zamana göre ölçeklenen modüller.',
  },
];

/** Danışmanlığın devreye girdiği tipik durumlar. */
const consultingCases = [
  'İki ekip ya da iki departman arasında tıkanmış, toplantılarda dönüp duran bir mesele',
  'Bir yönetici ile ekibi arasında aşınmış güven',
  'Ortaklar arasında, kararların alınamadığı bir anlaşmazlık',
  'Tedarikçi, müşteri ya da iş ortağıyla sürtüşmeye dönüşmüş bir ilişki',
  'Birleşme, satın alma ya da yeniden yapılanma sonrası kültür çatışması',
];

const consultingSteps = [
  { t: 'Ayrı dinleme görüşmeleri', d: 'Taraflarla tek tek konuşuyorum. Herkes, karşı tarafa cevap verme baskısı olmadan meseleyi kendi ağzından anlatıyor.' },
  { t: 'Ortak oturum', d: 'Tarafları aynı masaya getiriyorum. Amaç kimin haklı olduğunu belirlemek değil; her iki tarafın ihtiyacının duyulabilir hâle gelmesi.' },
  { t: 'Anlaşma ve takip', d: 'Somut, uygulanabilir adımlar üzerinde anlaşıyoruz. Bir süre sonra, anlaşmanın gerçek hayatta tutup tutmadığına birlikte bakıyoruz.' },
];

const cv = [
  { y: '2023 →', t: 'Uluslararası Arabuluculuk Eğitim Programı', d: 'Liv Larsson ve Kay Rung’ın programında asistanlık' },
  { y: '2022 →', t: 'CNVC Sertifikalı Eğitmen', d: 'Center for Nonviolent Communication' },
  { y: '2019 →', t: 'Şiddetsiz İletişim Türkiye Derneği üyesi', d: '' },
  { y: '2017–2022', t: 'Sosyal etki uzmanlığı', d: 'Enerji sektörü sosyal etki alanı' },
  { y: '2013–2016', t: 'BBOM Ankara Kooperatifi', d: 'Genel Koordinatör ve Yönetim Kurulu Başkanı' },
  { y: '2000–2012', t: 'Proje yönetimi', d: 'Kırsal kalkınma, doğa koruma, yaban hayatı ve erozyon önleme projeleri' },
  { y: '1999', t: 'ODTÜ Sosyoloji', d: 'Orta Doğu Teknik Üniversitesi' },
];

const longs = [
  { t: 'Anda Kal Canda Kal', d: 'Şiddetsiz İletişim’e giriş ve temel beceri programı. Dört adım, şefkati engelleyenler, empati ve dürüstçe ifade, “hayır” ve “evet” demenin yolları.', m: [['Süre', '36 saat'], ['Seviye', 'Başlangıç'], ['Format', 'Hibrit']] },
  { t: 'Anahtar Ayrımlar', d: '54 anahtar ayrımı sistematik olarak ele alan derinleşme programı. Bu kataloğun dört serisi bu programdan gelir. 8. yılında sürüyor.', m: [['Süre', '82,5 saat'], ['Oturum', '33'], ['Seviye', 'Orta-İleri']] },
  { t: 'Anlaşmazlık Dönüştürme', d: 'Arabuluculuk, üçüncü taraf empatisi, grup dinamiklerinde çatışma ve sistemik anlaşmazlıklar. Danışmanlık hizmetinin eğitim karşılığı.', m: [['Süre', '60 saat'], ['Oturum', '12'], ['Seviye', 'İleri']] },
];

const formats = [
  ['Tematik', 'Tek oturum · 2–3 saat', 'Belirli bir konuya odaklanmak, ekibi tanıştırmak', '10–25 kişi'],
  ['Kısa dönemli', 'Yarım gün – 1 tam gün', 'Tek bir modülü uygulamalı olarak çalışmak', '8–20 kişi'],
  ['Orta dönemli', 'Modüler seri · haftalara yayılır', 'Birkaç modülü sırayla çalışmak, aralarda işe taşımak', '8–16 kişi'],
  ['Uzun dönemli', '36–82,5 saat · kapalı grup', 'Kurum içinde kalıcı bir pratik kültürü kurmak', '8–15 kişi'],
];
---

<PageLayout
  title="Kurumsal Eğitim Kataloğu"
  description="Gonca Fide’nin kurumlara yönelik Şiddetsiz İletişim eğitim kataloğu: ekip içi iletişim, geri bildirim kültürü, anlaşmazlık dönüştürme ve liderlikte güç ayrımları. PDF olarak indirilebilir."
>
  <JsonLd slot="jsonld" schema={schema} />

  <!-- Hero -->
  <section class="kat-hero">
    <div class="container-site">
      <p class="eyebrow mb-4">Kurumsal Eğitim Kataloğu</p>
      <h1>Kurumlar için <em>Şiddetsiz İletişim</em></h1>
      <p class="kat-lede">
        Ekiplerin birbirini suçlamadan konuşabildiği, anlaşmazlığın bastırılmak yerine
        dönüştürüldüğü bir iletişim kültürü için üç ayrı çalışma biçimi:
        bire bir koçluk, anlaşmazlık danışmanlığı ve eğitimler.
      </p>
      <div class="kat-actions no-print">
        <a class="btn-primary" href={PDF} download>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
            <path d="M8 2v8m0 0L4.5 6.5M8 10l3.5-3.5M2.5 13h11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          PDF olarak indir
        </a>
        <a class="btn-ghost" href="/iletisim?program=kurumsal">İhtiyaç görüşmesi talep et</a>
      </div>
      <div class="kat-meta">
        <p><b>Gonca Fide</b> · CNVC Sertifikalı Eğitmen</p>
        <p>1.500+ saat Şiddetsiz İletişim deneyimi</p>
        <p><b>2026–2027</b> kataloğu</p>
      </div>
    </div>
  </section>

  <!-- Hizmetler: kurumun satın alabileceği üç çalışma biçimi -->
  <section class="section-padding">
    <div class="container-site">
      <p class="eyebrow mb-3">Hizmetler</p>
      <h2 class="kat-h2">Üç ayrı çalışma biçimi</h2>
      <p class="kat-body">
        Bir kurum bana üç farklı şekilde çalışabilir. Hangisinin işinize yarayacağı
        çoğu zaman ilk görüşmede netleşir — bazen de üçü birlikte yürür.
      </p>
      <ol class="svc-grid">
        {services.map((sv, i) => (
          <li class="svc">
            <span class="svc-n">{String(i + 1).padStart(2, '0')}</span>
            <p class="svc-kind">{sv.n}</p>
            <h3>{sv.t}</h3>
            <p class="svc-d">{sv.d}</p>
            <a class="svc-link" href={`#${sv.id}`}>Ayrıntılar</a>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Neden -->
  <section class="section-padding">
    <div class="container-site">
      <p class="eyebrow mb-3">Neden bu eğitim</p>
      <h2 class="kat-h2">Suçlama ve savunma döngüsünü kırmak</h2>
      <p class="kat-body">
        Kurumlarda iletişimin bozulduğu yer çoğunlukla niyet değil, dildir. “Sen hep…” ile
        başlayan bir cümle karşısındakinde savunma refleksi uyandırır; savunma yeni bir
        suçlamayı doğurur ve mesele konuşulamadan taraflaşır. Şiddetsiz İletişim, Marshall
        Rosenberg’in geliştirdiği, gözlem–duygu–ihtiyaç–rica adımlarına dayanan somut bir dil
        pratiğidir. Kurumsal bağlamda amacı basittir: kimsenin haklı çıkmasına gerek kalmadan,
        işin gerçekten konuşulabilmesi.
      </p>
      <div class="gains">
        {gains.map((g) => (
          <article class="gain">
            <h3>{g.t}</h3>
            <p>{g.d}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Eğitmen -->
  <section class="section-padding kat-tint">
    <div class="container-site">
      <p class="eyebrow mb-3">Eğitmen</p>
      <h2 class="kat-h2">Gonca Fide</h2>
      <div class="trainer">
        <img src="/images/gonca-fide.jpg" width="416" height="603" loading="lazy" decoding="async"
             alt="Gonca Fide — CNVC Sertifikalı Şiddetsiz İletişim Eğitmeni" class="portrait" />
        <div>
          <p class="kat-body">
            Kurumsal dünyayı eğitim salonunun dışından da tanıyan bir eğitmen. Sosyoloji
            eğitiminin ardından on yılı aşkın süre kalkınma, doğa koruma ve enerji sektörünün
            sosyal etki alanında proje yönetti; kooperatif kurdu, yönetim kurulu başkanlığı
            yaptı. Şiddetsiz İletişim’i bu deneyimin içinden, “anlaşma zemini nasıl oluşur?”
            sorusunun peşinde keşfetti.
          </p>
          <ul class="cv">
            {cv.map((c) => (
              <li>
                <time>{c.y}</time>
                <div><b>{c.t}</b>{c.d && <small>{c.d}</small>}</div>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- 01 · Bire bir empatik koçluk -->
  <section class="section-padding" id="kocluk">
    <div class="container-site">
      <p class="eyebrow mb-3">01 · Bire bir</p>
      <h2 class="kat-h2">Empatik Koçluk</h2>
      <div class="two-col">
        <div>
          <p class="kat-body">
            Empatik koçluk, Şiddetsiz İletişim'in empati pratiğini bireysel seanslar
            aracılığıyla sunmaktır. Terapiden, geleneksel koçluktan ve danışmanlıktan
            farklıdır — yönlendirme yerine tam varlık ve derin dinleme üzerine kuruludur.
            Amaç size çözüm vermek değil, kendi içsel bilgeliğinize ulaşmanız için
            yanınızda olmaktır.
          </p>
          <p class="kat-body" style="margin-top:1rem">
            Kurumsal bağlamda çoğunlukla yöneticiler, ekip liderleri ve zor bir dönemden
            geçen anahtar roller için kullanılıyor. Seanslar için Şiddetsiz İletişim
            bilgisi gerekmez; konuşma tamamen kişinin kendi dilinde ilerler.
          </p>
        </div>
        <div class="side">
          <p class="side-t">Ne zaman işe yarar</p>
          <ul class="ticks">
            <li>Zor bir duyguyla — öfke, kırgınlık, tükenmişlik — yalnız kalmak istemediğinizde</li>
            <li>İlişkisel bir çatışmanın içindeyken ne hissettiğinizi netleştirmek için</li>
            <li>Önemli bir kararın arifesinde, ihtiyaçlarınızı daha net görmek için</li>
            <li>Yargılanmadan, çözüm almadan, gerçekten duyulmak için</li>
          </ul>
          <dl class="facts">
            <div><dt>Süre</dt><dd>60–90 dk (maks. 2 saat)</dd></div>
            <div><dt>Format</dt><dd>Online veya yüz yüze</dd></div>
