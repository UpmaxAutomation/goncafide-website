---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import YouTubeEmbed from '../../components/ui/YouTubeEmbed.astro';

// Upcoming events only. Past-dated and draft entries are filtered out.
// The collection starts empty → honest "no scheduled dates yet" state.
//
// Everything below works in UTC on purpose. Frontmatter carries date-only
// values, which Zod coerces to UTC midnight; reading them back in the build
// machine's local time shifts every date a day earlier anywhere west of UTC.
const todayUTC = new Date();
todayUTC.setUTCHours(0, 0, 0, 0);

const all = await getCollection('etkinlikler', ({ data }) => !data.draft);

// A fixed cohort expires by itself once its start date passes. An open-enrollment
// season entry (no announced first meeting) carries no date to expire on, so it
// trails the dated ones and stays until removed by hand.
const ts = (e: (typeof all)[number]) => new Date(e.data.startDate ?? 0).getTime();
const dated = all
  .filter((e) => e.data.startDate && new Date(e.data.startDate) >= todayUTC)
  .sort((a, b) => ts(a) - ts(b));
const undated = all.filter((e) => !e.data.startDate);
const upcoming = [...dated, ...undated];

const fmt = (d: Date) =>
  new Date(d).toLocaleDateString('tr-TR', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
    timeZone: 'UTC',
  });

// Only dated events go into structured data — schema.org/Event requires a
// startDate, and Google drops the whole item without one.
const eventsSchema = dated.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'ItemList',
      'itemListElement': dated.map((e, i) => ({
        '@type': 'ListItem',
        'position': i + 1,
        'item': {
          '@type': 'Event',
          'name': e.data.title,
          'startDate': new Date(e.data.startDate ?? 0).toISOString().slice(0, 10),
          ...(e.data.endDate ? { 'endDate': new Date(e.data.endDate).toISOString().slice(0, 10) } : {}),
          'eventAttendanceMode':
            e.data.format === 'Online Grup'
              ? 'https://schema.org/OnlineEventAttendanceMode'
              : 'https://schema.org/OfflineEventAttendanceMode',
          'organizer': { '@type': 'Person', 'name': 'Gonca Fide' },
          ...(e.data.description ? { 'description': e.data.description } : {}),
        },
      })),
    }
  : null;
---

<PageLayout
  title="Etkinlikler"
  description="Gonca Fide ile yaklaşan Şiddetsiz İletişim atölyeleri ve seminerleri. Yeni dönem tarihleri ve kayıt bilgileri."
>
  {eventsSchema && (
    <script slot="jsonld" type="application/ld+json" set:html={JSON.stringify(eventsSchema)} />
  )}

  <!-- Header -->
  <section class="bg-[var(--color-surface)] pt-12 pb-14 lg:pt-20 lg:pb-20 border-b border-[var(--color-border)]">
    <div class="container-site">
      <p class="eyebrow mb-4">Etkinlikler</p>
      <h1 class="font-display text-4xl lg:text-5xl font-light -tracking-[0.04em] text-[var(--color-ink)] leading-[1.05] mb-4">
        Yaklaşan atölyeler
      </h1>
      <p class="text-[var(--color-ink-muted)] text-lg max-w-xl">
        Yeni dönem grup programları ve tek oturumluk seminerlerin tarihlerini burada paylaşıyorum.
      </p>
    </div>
  </section>

  <section class="section-padding bg-[var(--color-canvas)]">
    <div class="container-site">
      {upcoming.length > 0 ? (
        <div class="max-w-3xl space-y-4">
          {upcoming.map((e) => (
            <div class="p-6 rounded-2xl bg-white" style="box-shadow: var(--shadow-card);">
              <div class="flex flex-col sm:flex-row sm:items-center gap-4 sm:gap-6">
                <div class="flex items-start gap-4 flex-shrink-0 sm:w-72">
                  {e.data.coverImage && (
                    <a
                      href={e.data.coverImage.src}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="flex-shrink-0 rounded-lg focus:outline-none focus-visible:ring-2 focus-visible:ring-[var(--color-plum-400)]"
                      aria-label={`${e.data.title} afişini büyüt`}
                    >
                      <img
                        src={e.data.coverImage.src}
                        alt={e.data.coverImage.alt}
                        width="700"
                        height="874"
                        loading="lazy"
                        decoding="async"
                        class="w-20 h-auto rounded-lg border border-[var(--color-border)]"
                      />
                    </a>
                  )}
                  <div class="min-w-0">
                    {e.data.startDate ? (
                      <>
                        <p class="font-display text-lg text-[var(--color-plum-700)]">{fmt(e.data.startDate)}</p>
                        {e.data.endDate && <p class="text-xs text-[var(--color-ink-muted)]">— {fmt(e.data.endDate)}</p>}
                      </>
                    ) : (
                      <p class="font-display text-lg text-[var(--color-plum-700)]">{e.data.dateLabel}</p>
                    )}
                    <span class="inline-block mt-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-[var(--color-plum-50)] text-[var(--color-plum-700)] border border-[var(--color-plum-200)]">{e.data.format}</span>
                    {e.data.location && (
                      <p class="text-xs text-[var(--color-ink-muted)] mt-1.5">{e.data.location}</p>
                    )}
                  </div>
                </div>
                <div class="flex-1">
                  <h2 class="font-display text-xl font-light -tracking-[0.02em] text-[var(--color-ink)] leading-snug">{e.data.title}</h2>
                  {e.data.description && <p class="text-[var(--color-ink-muted)] text-sm mt-1.5 leading-relaxed">{e.data.description}</p>}
                </div>
                <a
                  href={e.data.enrollmentUrl ?? '/iletisim'}
                  {...(e.data.enrollmentUrl ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                  class="flex-shrink-0 inline-flex items-center justify-center py-3 px-5 rounded-xl bg-[var(--color-orchid-500)] text-white font-semibold text-sm hover:bg-[var(--color-orchid-600)] transition-colors min-h-[44px]"
                >
                  {e.data.enrollmentOpen ? 'Kayıt' : 'Bilgi al'}
                </a>
              </div>
              {e.data.youtubeId && (
                <div class="mt-5 pt-5 border-t border-[var(--color-border)]">
                  <p class="eyebrow mb-3">Tanıtım Videosu</p>
                  <YouTubeEmbed
                    id={e.data.youtubeId}
                    start={e.data.youtubeStart}
                    title={`${e.data.title} — Tanıtım`}
                    class="max-w-xl"
                  />
                </div>
              )}
            </div>
          ))}
        </div>
      ) : (
        <div class="max-w-xl mx-auto text-center py-10">
          <div class="w-14 h-14 mx-auto mb-6 rounded-2xl bg-[var(--color-plum-50)] text-[var(--color-plum-500)] flex items-center justify-center" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M7 3v3M17 3v3M3.5 9h17M5 5h14a1.5 1.5 0 0 1 1.5 1.5V19A1.5 1.5 0 0 1 19 20.5H5A1.5 1.5 0 0 1 3.5 19V6.5A1.5 1.5 0 0 1 5 5z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </div>
          <h2 class="font-display text-2xl lg:text-3xl font-light text-[var(--color-ink)] mb-3 -tracking-[0.02em]">
            Şu an planlanmış bir tarih yok
          </h2>
          <p class="text-[var(--color-ink-muted)] leading-relaxed mb-8">
            Yeni dönem atölyeleri açıldığında ilk siz haberdar olun. Bültene katılın
            ya da doğrudan yazın — size uygun bir grup oluştuğunda haber vereyim.
          </p>
          <div class="flex flex-col sm:flex-row gap-3 justify-center">
            <a href="/iletisim" class="inline-flex items-center justify-center py-3.5 px-6 rounded-xl bg-[var(--color-orchid-500)] text-white font-semibold text-sm hover:bg-[var(--color-orchid-600)] transition-colors min-h-[48px]">
              İletişime Geç
            </a>
            <a href="/programlar" class="inline-flex items-center justify-center py-3.5 px-6 rounded-xl border border-[var(--color-ink)]/20 text-[var(--color-ink)] font-medium text-sm hover:bg-[var(--color-surface)] transition-colors min-h-[48px]">
              Programları İncele
            </a>
          </div>
        </div>
      )}
    </div>
  </section>
</PageLayout>
