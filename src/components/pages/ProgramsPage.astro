---
import { getCollection } from 'astro:content';
import { entriesFor, slugOf, getLangFromUrl, useTranslations, levelLabel, formatLabel } from '../../i18n/ui';
import PageLayout from '../../layouts/PageLayout.astro';
import ProgramCard from '../programs/ProgramCard.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const allPrograms = entriesFor(await getCollection('programlar', ({ data }) => !data.draft), lang);
const programs = allPrograms.sort((a, b) => a.data.order - b.data.order);

const groupPrograms = programs.filter((p) => p.data.format === 'Online Grup' || p.data.format === 'Hibrit');
const individualPrograms = programs.filter((p) => p.data.format === 'Bireysel (1:1)');

// Group the online-group programs by level (Gonca's taxonomy: Başlangıç → İleri)
const LEVEL_ORDER = ['Başlangıç', 'Orta', 'Orta-İleri', 'İleri', 'Tüm Seviyeler'];
const byLevel = LEVEL_ORDER
  .map((level) => ({ level, items: groupPrograms.filter((p) => p.data.level === level) }))
  .filter((g) => g.items.length > 0);

const seminerler = entriesFor(await getCollection('seminerler', ({ data }) => !data.draft), lang)
  .sort((a, b) => a.data.order - b.data.order);

// Section headers per level (group program sections)
const LEVEL_BLURB: Record<string, Record<string, string>> = {
  tr: {
    'Başlangıç': 'Şiddetsiz İletişim’e ilk adım — temel kavramlar ve dört adım.',
    'Orta': 'Giriş sonrası beceriyi derinleştiren programlar.',
    'Orta-İleri': 'NVC’nin kapsam ve derinliğini anlamaya yarayan kavramlarla kişileri ileri seviyeye taşıyan derinleşme programı.',
    'İleri': 'Anlaşmazlık dönüştürme ve günlük hayata entegre etme.',
    'Tüm Seviyeler': 'Her seviyeden katılımcıya açık çalışmalar.',
  },
  en: {
    'Başlangıç': 'The first step into Nonviolent Communication — the core concepts and the four steps.',
    'Orta': 'Programmes that deepen the skills after the introduction.',
    'Orta-İleri': 'A deepening programme that carries you to an advanced level, through the concepts that reveal the reach and depth of NVC.',
    'İleri': 'Transforming disagreement, and integrating NVC into daily life.',
    'Tüm Seviyeler': 'Open to participants at every level.',
  },
};

const OVERVIEW_BLURB: Record<string, Record<string, string>> = {
  tr: {
    'Başlangıç': 'Şiddetsiz İletişim’e ilk adım — temel kavramlar ve dört adım.',
    'Orta': 'Giriş sonrası beceriyi derinleştiren programlar. Örn: Anahtar Ayrımlar',
    'İleri': 'Farkındalık geliştirme ve NVC’yi günlük hayatta uygulama pratikleri edinme. Anlaşmazlık Dönüştürme ve tematik programlar.',
  },
  en: {
    'Başlangıç': 'The first step into Nonviolent Communication — the core concepts and the four steps.',
    'Orta': 'Programmes that deepen the skills after the introduction. For example: Key Differentiations.',
    'İleri': 'Growing awareness and building the practice of applying NVC day to day. Conflict Transformation and the thematic programmes.',
  },
};

const levelBlurb = LEVEL_BLURB[lang];
const overviewBlurb = OVERVIEW_BLURB[lang];
---

<PageLayout
  title={t('programs.title')}
  description={t('programs.metaDescription')}
>
  <!-- Header -->
  <section class="bg-[var(--color-surface)] pt-12 pb-14 lg:pt-20 lg:pb-20 border-b border-[var(--color-border)]">
    <div class="container-site">
      <p class="eyebrow mb-4">{t('programs.title')}</p>
      <h1 class="font-display text-4xl lg:text-5xl font-light -tracking-[0.04em] text-[var(--color-ink)] leading-[1.05] mb-4">
        {t('programs.heading1')}<br />{t('programs.heading2')}
      </h1>
      <p class="text-[var(--color-ink-muted)] text-lg max-w-xl">
        {t('programs.intro')}
      </p>
      <p class="mt-5 text-sm lg:text-base text-[var(--color-ink-muted)] max-w-2xl">
        <span class="font-semibold text-[var(--color-iris-700)]">{t('programs.pathLabel')}</span>
        {t('programs.path')}
      </p>
    </div>
  </section>

  <!-- 3-level overview -->
  <section class="bg-[var(--color-canvas)] pt-10 lg:pt-14">
    <div class="container-site">
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        {['Başlangıç', 'Orta', 'İleri'].map((lvl, i) => (
          <div class="flex items-start gap-3 p-5 rounded-2xl bg-[var(--color-surface)]">
            <span class="font-display text-2xl font-light text-[var(--color-orchid-500)] leading-none">{i + 1}</span>
            <div>
              <p class="font-body font-semibold text-sm text-[var(--color-ink)]">{levelLabel(lvl, lang)} {t('programs.levelSuffix')}</p>
              <p class="text-xs text-[var(--color-ink-muted)] mt-1 leading-relaxed">{overviewBlurb[lvl]}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Group programs, grouped by level -->
  {byLevel.map((group) => (
    <section class="section-padding bg-[var(--color-canvas)] !pb-0 last:!pb-[var(--spacing-section)]">
      <div class="container-site">
        <div class="mb-8">
          <p class="eyebrow mb-3">{levelLabel(group.level, lang)} {t('programs.levelSuffix')}</p>
          <h2 class="font-display text-2xl lg:text-3xl font-light -tracking-[0.03em] text-[var(--color-ink)]">
            {levelBlurb[group.level]}
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 lg:gap-6">
          {group.items.map((program) => (
            <ProgramCard
              title={program.data.title}
              description={program.data.description}
              level={program.data.level}
              format={program.data.format}
              totalHours={program.data.totalHours}
              sessionDuration={program.data.sessionDuration}
              slug={slugOf(program.id)}
              enrollmentOpen={program.data.enrollmentOpen}
              image={program.data.coverImage}
            />
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Tematik Seminerler -->
  {seminerler.length > 0 && (
    <section class="section-padding bg-[var(--color-surface)]">
      <div class="container-site">
        <div class="mb-8">
          <p class="eyebrow mb-3">{t('programs.seminarsEyebrow')}</p>
          <h2 class="font-display text-2xl lg:text-3xl font-light -tracking-[0.03em] text-[var(--color-ink)]">
            {t('programs.seminarsHeading')}
          </h2>
          <p class="text-[var(--color-ink-muted)] mt-3 max-w-xl">
            {t('programs.seminarsIntro')}
          </p>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 lg:gap-6">
          {seminerler.map((s) => (
            <div class="flex flex-col p-6 lg:p-7 rounded-2xl bg-white" style="box-shadow: var(--shadow-card);">
              <div class="flex items-center gap-2 mb-3 flex-wrap">
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-[var(--color-iris-50)] text-[var(--color-iris-700)] border border-[var(--color-iris-200)]">{levelLabel(s.data.level, lang)}</span>
                <span class="px-2.5 py-0.5 rounded-full text-xs font-medium bg-[var(--color-surface)] text-[var(--color-ink-muted)] border border-[var(--color-border)]">{formatLabel(s.data.format, lang)}</span>
              </div>
              <h3 class="font-display text-xl font-light -tracking-[0.02em] text-[var(--color-ink)] mb-2.5 leading-snug">{s.data.title}</h3>
              <p class="text-[var(--color-ink-muted)] text-sm leading-relaxed flex-1">{s.data.description}</p>
              <a href={lang === 'en' ? '/en/contact' : '/iletisim'} class="mt-5 inline-flex items-center gap-1.5 text-[var(--color-orchid-500)] hover:text-[var(--color-orchid-600)] text-sm font-medium transition-colors">
                {t('events.info')}
                <svg width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Individual sessions -->
  {individualPrograms.length > 0 && (
    <section class="section-padding bg-[var(--color-canvas)]">
      <div class="container-site">
        <div class="mb-8">
          <p class="eyebrow mb-3">{t('programs.individual')}</p>
          <h2 class="font-display text-2xl lg:text-3xl font-light -tracking-[0.03em] text-[var(--color-ink)]">
            Sizinle bire bir
          </h2>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-5 lg:gap-6 lg:max-w-2xl">
          {individualPrograms.map((program) => (
            <ProgramCard
              title={program.data.title}
              description={program.data.description}
              level={program.data.level}
              format={program.data.format}
              totalHours={program.data.totalHours}
              sessionDuration={program.data.sessionDuration}
              slug={slugOf(program.id)}
              enrollmentOpen={program.data.enrollmentOpen}
              image={program.data.coverImage}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- Corporate cross-link -->
  <section class="bg-[var(--color-surface)] py-12 border-t border-[var(--color-border)]">
    <div class="container-site">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-5">
        <div>
          <h2 class="font-display text-xl lg:text-2xl font-light text-[var(--color-ink)] -tracking-[0.02em]">{t('programs.corpHeading')}</h2>
          <p class="text-[var(--color-ink-muted)] text-sm mt-1 max-w-lg">{t('programs.corpIntro')}</p>
        </div>
        <a href={lang === 'en' ? '/en/for-organizations' : '/kurumsal'} class="inline-flex items-center justify-center py-3.5 px-6 rounded-xl border border-[var(--color-plum-300)] text-[var(--color-plum-700)] font-semibold text-sm hover:bg-[var(--color-plum-50)] transition-colors min-h-[48px] flex-shrink-0">
          {t('programs.corpCta')}
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-[var(--color-plum-800)] py-16">
    <div class="container-site text-center">
      <h2 class="font-display text-3xl font-light text-white mb-4 -tracking-[0.03em]">
        {t('programs.ctaHeading')}
      </h2>
      <p class="text-[var(--color-cream)]/70 mb-8 max-w-md mx-auto">
        {t('programs.ctaIntro')}
      </p>
      <a
        href={lang === 'en' ? '/en/contact' : '/iletisim'}
        class="inline-flex items-center justify-center py-4 px-8 rounded-xl bg-[var(--color-orchid-500)] text-white font-semibold text-sm hover:bg-[var(--color-orchid-600)] transition-colors min-h-[52px]"
      >
        {t('nav.cta')}
      </a>
    </div>
  </section>
</PageLayout>
