---
import { getLangFromUrl, useTranslations, section, levelLabel, formatLabel } from '../../i18n/ui';
import Badge from '../ui/Badge.astro';

interface Props {
  title: string;
  subtitle?: string;
  level: string;
  format: string;
  totalHours?: number;
  sessionCount?: number;
  sessionDuration?: string;
  enrollmentOpen: boolean;
  slug: string;
  image?: { src: string; alt: string };
}

const { title, subtitle, level, format, totalHours, sessionCount, sessionDuration, enrollmentOpen, slug, image } = Astro.props;

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const contactHref = lang === 'en' ? '/en/contact' : '/iletisim';
---

<section class="bg-[var(--color-surface)] pt-10 pb-12 lg:pt-16 lg:pb-20 border-b border-[var(--color-border)]">
  <div class="container-site">
    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 text-[var(--color-ink-muted)]">
        <li><a href={lang === 'en' ? '/en/' : '/'} class="hover:text-[var(--color-ink)] transition-colors">{t('nav.home')}</a></li>
        <li aria-hidden="true">›</li>
        <li><a href={section[lang].programs} class="hover:text-[var(--color-ink)] transition-colors">{t('teaser.eyebrow')}</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-[var(--color-ink)] font-medium">{title}</li>
      </ol>
    </nav>

    <div class="flex flex-col lg:flex-row gap-8 lg:gap-16 items-start">
      <!-- Left: title block -->
      <div class="flex-1">
        {image && (
          <img
            src={image.src}
            alt={image.alt}
            width="800" height="800" loading="eager" fetchpriority="high" decoding="async"
            class="w-24 h-24 lg:w-28 lg:h-28 rounded-3xl object-cover ring-1 ring-[var(--color-iris-200)] mb-6"
            style="box-shadow: var(--shadow-card);"
          />
        )}
        <div class="flex items-center gap-2 flex-wrap mb-4">
          <Badge variant="iris">{levelLabel(level, lang)}</Badge>
          <Badge variant="neutral">{formatLabel(format, lang)}</Badge>
          {!enrollmentOpen && <Badge variant="orchid">{t('prog.closed')}</Badge>}
        </div>

        <h1 class="font-display text-4xl lg:text-5xl xl:text-6xl font-light -tracking-[0.04em] text-[var(--color-ink)] leading-[1.05] mb-4">
          {title}
        </h1>

        {subtitle && (
          <p class="text-[var(--color-ink-muted)] text-lg leading-relaxed max-w-xl">
            {subtitle}
          </p>
        )}
      </div>

      <!-- Right: stats + CTA card -->
      <div class="w-full lg:w-80 flex-shrink-0">
        <div
          class="rounded-2xl bg-white p-6"
          style="box-shadow: var(--shadow-card);"
        >
          <!-- Stats -->
          <dl class="grid grid-cols-2 gap-4 mb-6">
            {totalHours && (
              <div>
                <dt class="text-xs text-[var(--color-ink-muted)] mb-1">{t('prog.totalTime')}</dt>
                <dd class="font-display text-2xl font-light text-[var(--color-ink)]">{totalHours} <span class="text-base">{t('prog.hours')}</span></dd>
              </div>
            )}
            {sessionCount && (
              <div>
                <dt class="text-xs text-[var(--color-ink-muted)] mb-1">{t('prog.meetings')}</dt>
                <dd class="font-display text-2xl font-light text-[var(--color-ink)]">{sessionCount}+</dd>
              </div>
            )}
            {sessionDuration && (
              <div class="col-span-2">
                <dt class="text-xs text-[var(--color-ink-muted)] mb-1">{t('prog.sessionLength')}</dt>
                <dd class="font-body text-sm font-medium text-[var(--color-ink)]">{sessionDuration}</dd>
              </div>
            )}
            <div>
              <dt class="text-xs text-[var(--color-ink-muted)] mb-1">{t('prog.format')}</dt>
              <dd class="font-body text-sm font-medium text-[var(--color-ink)]">{formatLabel(format, lang)}</dd>
            </div>
            <div>
              <dt class="text-xs text-[var(--color-ink-muted)] mb-1">Seviye</dt>
              <dd class="font-body text-sm font-medium text-[var(--color-ink)]">{levelLabel(level, lang)}</dd>
            </div>
          </dl>

          <a
            href={`${contactHref}?program=${slug}`}
            class="flex items-center justify-center w-full py-4 px-5 rounded-xl bg-[var(--color-orchid-500)] text-white font-semibold text-sm tracking-wide hover:bg-[var(--color-orchid-600)] transition-colors min-h-[52px]"
          >
            {t('prog.enrollCta')}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
